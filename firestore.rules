rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.role == 'superadmin';
    }
    function belongsToTenant(tenantId) {
      return isSignedIn() && request.auth.token.tenantId == tenantId;
    }

    match /tenants/{tenantId} {
      allow read: if belongsToTenant(tenantId) || isSuperAdmin();
      allow write: if isSuperAdmin();

      match /{document=**} {
        allow read, write: if belongsToTenant(tenantId) || isSuperAdmin();
      }
    }

    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
